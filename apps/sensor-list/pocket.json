{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocketjs.sensor-list",
  "name": "sensor-list",
  "title": "MicroTS Sensor List",
  "version": "0.1.0",
  "engine": { "capabilities": { "requires": ["text.glyphs.baked", "input.buttons"] } },
  "app": {
    "entry": "apps/sensor-list/main.ts",
    "output": "sensor-list-main",
    "framework": "vue-vapor",
    "viewport": { "fixed": { "logical": [480, 272], "presentation": "integer-fit" } },
    "aot": true,
    "model": "compiled"
  }
}
